[Desktop Entry]
Type=Application
Version=1.0
Name=Conky System Monitor
GenericName=Desktop System Monitor
Comment=Desktop System Monitor for ThinkPad L440 (Zorin OS / XFCE)
Exec=bash -c "$HOME/.config/conky/start_conky.sh 3"
Terminal=false
StartupNotify=false
Hidden=false
X-GNOME-Autostart-enabled=true
OnlyShowIn=XFCE;
Categories=System;Monitor;
